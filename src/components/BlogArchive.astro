---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "./LocalizedText.astro";
import BlogBreadcrumbs from "./BlogBreadcrumbs.astro";
import BlogTimeline from "./BlogTimeline.astro";
import { blogCategories, getBlogEntries, type BlogCategoryId } from "../utils/blog";
import "../styles/blog.css";
import { getCollection, render } from "astro:content";
import DialogueBubbles from "./DialogueBubbles.astro";

interface Props { category: BlogCategoryId; }
const { category } = Astro.props;
const section = blogCategories.find(({ id }) => id === category)!;
const entries = (await getBlogEntries()).filter((entry) => entry.category === category && !(category === "dialogues" && entry.url === "/writings/cui-xiong-pian/"));
const dialogueIntroduction = category === "dialogues"
  ? (await getCollection("writings")).find((entry) => entry.data.slug === "cui-xiong-pian")
  : undefined;
const Introduction = dialogueIntroduction ? (await render(dialogueIntroduction)).Content : null;
---
<BaseLayout title={`${section.label.en} | Blog`} titleZh={`${section.label.zh} | Blog`} description={section.description.en} descriptionZh={section.description.zh} showHierarchyBack={false}>
  <BlogBreadcrumbs category={category} atCategory />
  <div class="blog-page blog-archive">
    <header class="blog-page-heading">
      <h1 class="blog-small-caps"><LocalizedText value={section.label} /></h1>
    </header>
    {Introduction && (
      <section class="dialogues-introduction prose writing-body cui-dialogue" lang="zh-Hant">
        <Introduction />
        <DialogueBubbles />
      </section>
    )}
    <BlogTimeline entries={entries} />
  </div>
</BaseLayout>
