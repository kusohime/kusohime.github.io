---
import LocalizedText from "./LocalizedText.astro";
import DialogueArchiveRelations from "./DialogueArchiveRelations.astro";
import { parseBlogDate, type BlogEntry } from "../utils/blog";
import { formatDate } from "../config/locales";

interface Props { entries: BlogEntry[]; }
const { entries } = Astro.props;
const isDialogueArchive = entries.some((entry) => entry.category === "dialogues");
const years = [...new Set(entries.map((entry) => parseBlogDate(entry.date)?.year ?? "undated"))];
---
<div class:list={["blog-timeline", { "dialogue-archive-map": isDialogueArchive }]} data-dialogue-archive={isDialogueArchive || undefined}>
  {years.map((year) => (
    <section class="blog-year" id={`year-${year}`} data-blog-year aria-labelledby={`heading-${year}`}>
      <h2 id={`heading-${year}`}>
        {year === "undated" ? <LocalizedText value={{ en: "Undated", zh: "未註日期" }} /> : year}
      </h2>
      <ol>
        {entries.filter((entry) => (parseBlogDate(entry.date)?.year ?? "undated") === year).map((entry) => {
          const date = parseBlogDate(entry.date);
          return (
            <li data-blog-entry data-date={entry.date} data-dialogue-slug={entry.category === "dialogues" ? entry.url.replace(/\/$/, "").split("/").pop() : undefined}>
              <time datetime={date ? entry.date : undefined} aria-label={formatDate(entry.date, "en")}>
                {date?.month ? `${date.month}${date.day ? `.${date.day}` : ""}` : "—"}
              </time>
              <article>
                <h3>
                  <a href={entry.url}><LocalizedText value={entry.title} /></a>
                  {entry.category === "translation" && entry.author && (
                    <span class="blog-entry-author"><LocalizedText value={entry.author} /></span>
                  )}
                </h3>
              </article>
            </li>
          );
        })}
      </ol>
    </section>
  ))}
  {isDialogueArchive && <DialogueArchiveRelations />}
</div>
