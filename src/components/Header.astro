---
// 中文：公開網站頁首、印章、主導覽與偏好控制。
// English: Public header, seal, primary navigation, and preference controls.
import NamePronunciation from "./NamePronunciation.astro";
import Preferences from "./Preferences.astro";
import {
  translate,
  type Locale,
  type TranslationKey,
} from "../config/locales";

interface Props {
  unavailableLanguages?: Locale[];
}

const { unavailableLanguages = [] } = Astro.props;
const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, "") || "/";

const isActivePath = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);

const navGroups = [
  {
    key: "nav.music" as TranslationKey,
    items: [
      { key: "nav.works" as TranslationKey, href: "/works" },
      { key: "nav.events" as TranslationKey, href: "/events" },
      { key: "nav.cv" as TranslationKey, href: "/cv" },
    ],
  },
];
const directLinks = [
  { key: "nav.blog" as TranslationKey, href: "/writings" },
];
---

<header class="site-header" data-source-file="src/components/Header.astro">
  <div class="header-row">
    <a class="site-seal" href="/" aria-label="Yixin Cui, home">
      <img
        class="site-seal-image"
        src="/favicon-512.png"
        alt=""
        width="32"
        height="32"
        aria-hidden="true"
      />
    </a>
    <p class="site-name">
      <a
        href="/"
        aria-label="Yixin Cui, home"
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        <NamePronunciation focusable={false} translate tooltipId="site-name-pronunciation" />
      </a>
    </p>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navGroups.map((group) => (
            <li class="nav-group">
              <details
                class="nav-dropdown"
                data-nav-menu
                data-active={group.items.some((item) => isActivePath(item.href)) ? "true" : undefined}
              >
                <summary>
                  <span data-i18n-key={group.key}>{translate("en", group.key)}</span>
                </summary>
                {/* 中文：外层容器负责展开／收拢动画（grid-template-rows），列表在其内被裁切。 */}
                {/* English: The panel animates the unfold (grid-template-rows);
                    the list inside is what gets clipped. */}
                <div class="nav-dropdown-panel">
                  <ul class="nav-dropdown-list">
                    {group.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          aria-current={isActivePath(item.href) ? "page" : undefined}
                        >
                          <span data-i18n-key={item.key}>
                            {translate("en", item.key)}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))
        }
        {directLinks.map((item) => (
          <li class="nav-direct">
            <a href={item.href} aria-current={isActivePath(item.href) ? "page" : undefined}>
              <span data-i18n-key={item.key}>{translate("en", item.key)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Preferences unavailableLanguages={unavailableLanguages} />
  </div>
</header>

<style>
  @media (max-width: 40rem) {
    .nav-direct a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--floating-control-size);
    }
  }
</style>
