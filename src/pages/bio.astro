---
// 中文：公開個人簡介；雙語正文可直接編輯 bioContent.json，或在本地 Studio 點選文字。
// English: Public biography; edit bilingual copy in bioContent.json or select text in the local Studio.
// 中文：作者提供的簡介使用完整 Markdown，與博客共用右側腳注。
// English: Author-supplied copy uses Markdown and the blog's shared margin notes.
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import NamePronunciation from "../components/NamePronunciation.astro";
import bioContent from "../config/bioContent.json";

async function renderBio(language: "en" | "zh") {
  const renderer = await createMarkdownProcessor({
    syntaxHighlight: false,
    smartypants: false,
    remarkRehype: { clobberPrefix: `bio-${language}-` },
  });
  const { code } = await renderer.render(
    `# ${bioContent.title[language]}[^as-of]\n\n${bioContent.intro[language]}\n\n${bioContent.body[language]}`,
  );
  const html = code
    .replace(/(<h2\b[^>]*>)Footnotes(<\/h2>)/g, (_match, opening, closing) =>
      opening + (language === "zh" ? "註釋" : "Footnotes") + closing,
    )
    .replaceAll('"footnote-label"', `"bio-${language}-footnote-label"`)
    .replace(
      /<a href="(\/(?:works|writings)\/[^"]*)">(?=(?:\(|（)?(?:Read\s|閱讀))/g,
      '<a class="home-bio-link bio-read-link" href="$1">',
    );
  const heading = html.match(/^<h1\b[^>]*>[\s\S]*?<\/h1>/);
  const content = html.slice(heading?.[0].length ?? 0).trimStart();
  const intro = content.match(/^<p>([\s\S]*?)<\/p>/);
  return {
    heading: heading?.[0] ?? "",
    intro: intro?.[1] ?? "",
    body: content.slice(intro?.[0].length ?? 0),
  };
}

const [english, chinese] = await Promise.all([renderBio("en"), renderBio("zh")]);
---

<BaseLayout
  title={bioContent.title.en}
  titleZh={bioContent.title.zh}
  description={bioContent.underConstruction ? "Biography — under construction." : bioContent.description.en}
  descriptionZh={bioContent.underConstruction ? "個人簡介：施工中。" : bioContent.description.zh}
  showHierarchyBack={false}
>
  <article class="detail-page bio-page" data-source-file="src/pages/bio.astro">
    {bioContent.underConstruction ? (
      <>
      <header class="detail-header">
        <h1><LocalizedText value={bioContent.title} /></h1>
      </header>
      <p class="bio-construction">
        <LocalizedText value={{ en: "Under construction.", zh: "施工中" }} />
      </p>
      </>
    ) : (
    <div class="prose bio-body" data-source-file="src/config/bioContent.json">
      <div class="lang-block" data-lang="en" lang="en">
        <header class="detail-header" set:html={english.heading} />
        <p>
          <NamePronunciation translate />{" "}<span
            data-editable-text
            data-source-file="src/config/bioContent.json"
            data-json-path="intro.en"
            set:html={english.intro}
          />
        </p>
        <div
          data-editable-text
          data-source-file="src/config/bioContent.json"
          data-json-path="body.en"
          set:html={english.body}
        />
      </div>
      <div class="lang-block" data-lang="zh" lang="zh-Hant-TW">
        <header class="detail-header" set:html={chinese.heading} />
        <p>
          <NamePronunciation translate /><span
            data-editable-text
            data-source-file="src/config/bioContent.json"
            data-json-path="intro.zh"
            set:html={chinese.intro}
          />
        </p>
        <div
          data-editable-text
          data-source-file="src/config/bioContent.json"
          data-json-path="body.zh"
          set:html={chinese.body}
        />
      </div>
    </div>
    )}
  </article>
</BaseLayout>

<style>
  .bio-page {
    max-width: var(--reading-width);
    margin-inline: auto;
  }

  .bio-body {
    --sidenote-width: min(13rem, calc((100vw - var(--reading-width)) / 2 - var(--sidenote-gap) - 2rem));
    --prose-line-height: 1.52;
  }

  :global(.bio-body .detail-header h1) {
    font-weight: 700;
  }

  /* The Chinese interface resets tracking on every inherited :lang(zh) element.
     Restore American Garamond's compact rhythm for embedded Latin text, while
     generated CJK and ruby runs retain full-width spacing. */
  :global(.bio-body .lang-block[data-lang="zh"] :is(p, li, .sidenote, a, em, strong, cite, sup, span)) {
    letter-spacing: -0.025em;
    word-spacing: -0.035em;
  }

  :global(.bio-body .lang-block[data-lang="zh"] :is(.cjk-run, .cjk-punctuation, .ruby-base, rt)) {
    letter-spacing: var(--cjk-letter-spacing);
    word-spacing: normal;
  }

  :global(.bio-body .detail-header .fn-ref),
  :global(.bio-body .detail-header .sidenote) {
    font-size: 0.82rem;
  }

  :global(.bio-body .detail-header .sidenote) {
    font-family: var(--font-body);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: normal;
  }

  :global(.bio-body .bio-read-link) {
    color: var(--theme-color);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.bio-body .bio-read-link:hover),
  :global(.bio-body .bio-read-link:focus-visible) {
    color: var(--theme-color);
    text-decoration: none;
  }

  :global(.bio-body .bio-read-link .mongolian-text) {
    display: inline;
    writing-mode: horizontal-tb;
    vertical-align: baseline;
    margin-inline-start: 0.2em;
  }

  :global(.bio-body .bio-read-link :is(.cjk-run, .cjk-punctuation, .ruby-base)) {
    display: inline-block;
    font-size: 1em;
    font-style: normal;
    font-synthesis: none;
    line-height: 1;
    vertical-align: baseline;
    transform: none;
  }

  :global(.bio-body .bio-read-link .all-caps-run) {
    letter-spacing: -0.025em;
  }

  :global(.bio-body .bio-read-link ruby) {
    ruby-position: over;
    ruby-align: center;
  }

  :global(.bio-body .bio-read-link rt) {
    font-family: var(--font-cjk-serif);
    font-size: 0.5em;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0;
  }

  /* Phone work references wrap within the reading column. Footnote disclosure
     uses the shared tap-to-open behavior in footnotes.css. */
  @media screen and (max-width: 40rem) {
    :global(.bio-body .bio-read-link) {
      white-space: normal;
      overflow-wrap: anywhere;
    }

  }
</style>
