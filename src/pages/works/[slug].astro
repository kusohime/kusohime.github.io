---
// 中文：根据作品 Markdown 生成单个作品详情页。
// English: Generates an individual work detail page from its Markdown file.
// Caveat / 注意：公开网址使用 frontmatter 中的 slug，而不是文件夹名称。
// Caveat: The public URL uses the frontmatter slug, not the folder name.
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import WorkTitle from "../../components/WorkTitle.astro";
import Comments from "../../components/Comments.astro";
import PeerTubeEmbed from "../../components/PeerTubeEmbed.astro";
import {
  formatCommission,
  formatDate,
  formatDedication,
  formatDuration,
  formatPremiere,
  translate,
} from "../../config/locales";
import { renderSafeInlineMarkdown } from "../../lib/safeHtml.js";
import { proseCounts } from "../../utils/cjkLanguage";
import "../../styles/kanbun.css";

export async function getStaticPaths() {
  const works = await getCollection(
    "works",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return works.map((work) => ({
    params: { slug: work.data.slug },
    props: { work },
  }));
}

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { Content } = await render(work);
const hasWorkContent = Boolean(work.body?.trim());
// 中文：作品说明采用「同页双语段落」写法，而非 index.zh.md；正文里几乎
// 没有汉字时视为只有英文，切到中文界面时给出提示。
// English: Work notes are written bilingually inline (no index.zh.md); when the
// body carries almost no Han text, treat it as English-only and note that in
// the Chinese UI.
// Image attributes and link labels for controls are not prose requiring translation.
const bodyProse = (work.body ?? "").replace(/<[^>]*>/g, " ");
const { han, latinWords } = proseCounts(bodyProse);
// 一两句以内的说明不值得挂提示，只对有实际英文段落的作品显示。
// Skip the note when the body is only a line or two of text.
const notesEnglishOnly = han < 20 && latinWords >= 15;
const {
  title,
  subtitle,
  subtitleZh,
  year,
  instrumentation,
  duration,
  dedication,
  commission,
  credits,
  premiere,
  recordingUrl,
  scoreUrl,
  video,
  image,
  imageAlt,
  description,
} = work.data;
const hasDuration = duration.display || duration.minutes !== undefined || duration.continuous;
// A "for ..." subtitle is already a scoring line. Show the more informative
// of the two lines on detail pages while keeping subtitles in the works index.
// The choices below were checked against both English and Chinese metadata.
const detailedScoring = new Set([
  "a-past-life",
  "a-song-in-the-winter",
  "sprechlehre",
  "twink-death",
  "urtonforschungen-ii",
  "wasserlenken",
]);
const scoringSubtitle = /^for\s+/i.test(subtitle?.trim() ?? "");
const preferInstrumentation = detailedScoring.has(work.id);
const showSubtitle = Boolean(subtitle && (!scoringSubtitle || !preferInstrumentation));
const showInstrumentation = !scoringSubtitle || preferInstrumentation;
---

<BaseLayout
  title={title}
  description={description}
  noindex={work.data.draft}
  unavailableLanguages={notesEnglishOnly ? ["zh"] : []}
>
  <article
    class="detail-page work-detail"
    data-work-slug={work.data.slug}
    data-source-file={`content/works/${work.id}/index.md`}
  >
    <header class="detail-header work-detail-header">
      {work.data.draft && <p class="draft-flag">Draft — not listed publicly</p>}
      <div class="work-title-line">
        <h1><WorkTitle title={title} ruby={work.data.titleRuby} splitLanguages /></h1>
        <p class="work-year">
          <time datetime={String(year)} data-i18n-date={String(year)}>
            {formatDate(year, "en")}
          </time>
        </p>
      </div>
      {showSubtitle && subtitle && (
        <p><LocalizedText value={{ en: subtitle, zh: subtitleZh }} /></p>
      )}
      {(showInstrumentation || hasDuration) && <p class="work-facts">
        {showInstrumentation && <span class="work-instrumentation"><LocalizedText value={instrumentation} /></span>}
        {hasDuration && (duration.display ? (
          <span class="work-duration"><LocalizedText value={duration.display} /></span>
        ) : (
          <span
            class="work-duration"
            data-i18n-duration
            data-duration-minutes={duration.minutes}
            data-duration-continuous={String(duration.continuous)}
            data-duration-approximate={String(duration.approximate)}
          >
            {formatDuration(duration, "en")}
          </span>
        ))}
      </p>}

      {commission && (
        <p class="work-commission">
          <em
            data-i18n-commission
            data-commission-en={commission.en}
            data-commission-zh={commission.zh}
            set:html={renderSafeInlineMarkdown(formatCommission(commission, "en"))}
          />
        </p>
      )}

      {
        (recordingUrl || scoreUrl) && (
          <nav class="resource-links" aria-label="Work resources">
            <ul>
              {recordingUrl && (
                <li>
                  <a href={recordingUrl} data-i18n-key="resource.recording">
                    {translate("en", "resource.recording")}
                  </a>
                </li>
              )}
              {scoreUrl && (
                <li>
                  <a href={scoreUrl} data-i18n-key="resource.score">
                    {translate("en", "resource.score")}
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )
      }
    </header>

    {video && <PeerTubeEmbed video={video} fallbackTitle={title} />}

    {
      image && (
        <figure class="media-placeholder">
          <img src={image} alt={imageAlt ?? ""} width="1200" height="800" />
        </figure>
      )
    }

    {hasWorkContent && (
      <div class="prose work-notes">
        <Content />
      </div>
    )}

    {
      (dedication || credits || premiere) && (
        <footer class="work-credits">
          {dedication && (
            <p>
              <em
                data-i18n-dedication
                data-dedication-en={dedication.en}
                data-dedication-zh={dedication.zh}
                set:html={renderSafeInlineMarkdown(formatDedication(dedication, "en"))}
              />
            </p>
          )}
          {credits?.map((credit) => (
            <p>
              <em>
                <span data-i18n-key="metadata.credits">
                  {translate("en", "metadata.credits")}
                </span>
                <span data-i18n-key="metadata.labelSeparator">
                  {translate("en", "metadata.labelSeparator")}
                </span>
                <LocalizedText value={credit} />
              </em>
            </p>
          ))}
          {premiere && (
            <p>
              <em
                data-i18n-premiere
                data-premiere-by-en={premiere.by.en}
                data-premiere-by-zh={premiere.by.zh}
                data-premiere-venue-en={premiere.venue?.en}
                data-premiere-venue-zh={premiere.venue?.zh}
                data-premiere-date={
                  premiere.date !== undefined ? String(premiere.date) : undefined
                }
                set:html={renderSafeInlineMarkdown(formatPremiere(premiere, "en"))}
              />
            </p>
          )}
        </footer>
      )
    }

    {work.data.comments && <Comments collection="works" slug={work.data.slug} />}

    <nav class="back-link" aria-label="Footer navigation">
      <a href="/works/">
        <span
          class="glyph-arrow glyph-arrow--back"
          data-arrow-glyph
          aria-hidden="true"
        ></span>
        <span data-i18n-key="common.backWorks">
          {translate("en", "common.backWorks")}
        </span>
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  import { initializeKanbun } from "../../scripts/kanbun";
  initializeKanbun();
</script>
