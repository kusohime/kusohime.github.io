---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { blogCategories, blogCategoryHref, getBlogEntries, parseBlogDate } from "../../utils/blog";
import { formatDate } from "../../config/locales";
import "../../styles/blog.css";

const entries = await getBlogEntries();
const sections = blogCategories.map((section) => ({
  ...section,
  items: entries.filter((entry) => entry.category === section.id),
}));
---
<BaseLayout title="Blog" titleZh="Blog" description="Translations, essays, and Dialogues with Kuma by Yixin Cui." descriptionZh="崔浥新的翻譯、隨筆與脆熊篇。" showHierarchyBack={false}>
  <div class="blog-page blog-home" data-source-file="src/pages/writings/index.astro">
    <header class="blog-page-heading"><h1 class="blog-small-caps">Blog</h1></header>
    <ol class="blog-sections">
      {sections.map((section) => (
        <li class="blog-section">
          <section aria-labelledby={`blog-${section.id}`}>
            <a class="blog-section-link" href={blogCategoryHref(section.id)}>
              <h2 class="blog-small-caps" id={`blog-${section.id}`}><LocalizedText value={section.label} /></h2>
              <span class="blog-section-count">{section.items.length}</span>
            </a>
            <ul class="blog-section-preview">
              {section.items.slice(0, 6).map((entry) => (
                <li>
                  <a href={entry.url}><LocalizedText value={entry.title} /></a>
                  <time datetime={parseBlogDate(entry.date) ? entry.date : undefined} data-i18n-date={entry.date} data-i18n-date-format="short">{formatDate(entry.date, "en", "short")}</time>
                </li>
              ))}
            </ul>
            <a class="blog-view-all blog-small-caps" href={blogCategoryHref(section.id)}><LocalizedText value={{ en: "View all", zh: "查看全部" }} /><span aria-hidden="true"> → </span></a>
          </section>
        </li>
      ))}
    </ol>
  </div>
  <script>
    // Keep old bookmarked tag URLs useful after replacing the combined index.
    const oldTag = decodeURIComponent(location.hash.slice(1)).match(/^writings-tag-(.+)$/)?.[1];
    if (oldTag) {
      const category = oldTag === "translation" ? "translation" : "essays";
      location.replace(`/writings/${category}/${oldTag === "translation" ? "" : `?tag=${encodeURIComponent(oldTag)}`}`);
    }
  </script>
</BaseLayout>
